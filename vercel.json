{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.8.0"
    }
  ],
  "routes": [
    {
      "src": "/Admin_panel",
      "dest": "/Admin_panel.php"
    },
    {
      "src": "/admin_panel",
      "dest": "/Admin_panel.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
